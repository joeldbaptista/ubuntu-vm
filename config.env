# Every setting of this sandbox lives here. This is the only file you need to
# edit, and in most cases you do not need to edit it at all.

# Name of the VM, and prefix of every libvirt object this project creates.
# Left empty on purpose: when it is empty, the scripts use the name of this
# directory. So copying this directory and renaming the copy gives a second,
# fully independent VM without editing anything.
VM_NAME=""

# Guest sizing. The defaults match the project specification.
VCPU=2
MEMORY_MB=4096
DISK_GB=16

# Ubuntu Server cloud image used as the base disk.
BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"

# libvirt connection and the pre-existing host resources the VM attaches to.
# The pool and the network already exist on homelab and are shared with other
# projects, so this project references them by name and never manages them.
LIBVIRT_URI="qemu:///system"
STORAGE_POOL="default"
NETWORK_NAME="default"

# Credentials injected into the guest by cloud-init.
SSH_USER="ubuntu"
SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"
SSH_PRIVATE_KEY="$HOME/.ssh/id_ed25519"

# Default destination of `make snapshot`. Relative paths are resolved against
# this project directory, so the default keeps snapshots inside the copy.
SNAPSHOT_DIR="snapshots"

# Seconds to wait for a graceful guest shutdown before forcing power off.
SHUTDOWN_TIMEOUT=60
